# Mesmo FFmpeg mínimo usado no bench da F5. No desktop também aceitamos os pacotes de desenvolvimento.
add_library(tube360-ffmpeg INTERFACE)
target_link_libraries(tube360 PRIVATE tube360-ffmpeg)
if(NOT FFMPEG_PREFIX AND NOT XSDK)
  find_package(PkgConfig QUIET)
  if(PkgConfig_FOUND)
    pkg_check_modules(AV QUIET IMPORTED_TARGET libavformat>=61 libavcodec>=61 libswresample libavutil)
  endif()
endif()
if(TARGET PkgConfig::AV)
  target_link_libraries(tube360-ffmpeg INTERFACE PkgConfig::AV)
else()
  if(NOT FFMPEG_PREFIX)
    set(target pc)
    if(XSDK)
      set(target xbox)
    endif()
    set(FFMPEG_PREFIX "${CMAKE_CURRENT_LIST_DIR}/../.work/ffmpeg-${target}")
    file(GLOB ffmpeg_recipe CONFIGURE_DEPENDS "${CMAKE_CURRENT_LIST_DIR}/../tools/ffmpeg-x360/*")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
      ${ffmpeg_recipe} "${CMAKE_CURRENT_LIST_DIR}/../tools/build-ffmpeg-x360.sh")
    set(ffmpeg_cc "${CMAKE_C_COMPILER}")
    if(XSDK)
      set(ffmpeg_cc "${XSDK_TOOLCHAIN}/bin/powerpc-xsdk-elf-gcc")
    endif()
    execute_process(COMMAND python3 "${CMAKE_CURRENT_LIST_DIR}/../tools/ffmpeg-x360/source-id.py" --cc "${ffmpeg_cc}"
      OUTPUT_VARIABLE ffmpeg_source_id OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
    set(ffmpeg_built_id "")
    if(EXISTS "${FFMPEG_PREFIX}/.tube360-source-id")
      file(STRINGS "${FFMPEG_PREFIX}/.tube360-source-id" ffmpeg_built_id)
    endif()
    if(NOT EXISTS "${FFMPEG_PREFIX}/lib/libavformat.a" OR NOT ffmpeg_built_id STREQUAL ffmpeg_source_id)
      execute_process(COMMAND "${CMAKE_CURRENT_LIST_DIR}/../tools/build-ffmpeg-x360.sh" ${target}
                      COMMAND_ERROR_IS_FATAL ANY)
    endif()
  endif()
  target_include_directories(tube360-ffmpeg INTERFACE "${FFMPEG_PREFIX}/include")
  foreach(lib avformat avcodec swresample avutil)
    target_link_libraries(tube360-ffmpeg INTERFACE "${FFMPEG_PREFIX}/lib/lib${lib}.a")
  endforeach()
  if(NOT XSDK)
    find_package(Threads REQUIRED)
    target_link_libraries(tube360-ffmpeg INTERFACE Threads::Threads m)
  endif()
endif()
